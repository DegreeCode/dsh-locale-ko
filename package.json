{
  "name": "dsh-language-pack-ko",
  "version": "1.1.1",
  "description": "Korean language pack for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DegreeCode/dsh-locale-ko.git"
  },
  "homepage": "https://github.com/DegreeCode/dsh-locale-ko#readme",
  "bugs": {
    "url": "https://github.com/DegreeCode/dsh-locale-ko/issues"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "language-pack",
    "korean",
    "ko"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
